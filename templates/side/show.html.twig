{% extends 'base.html.twig' %}

{% block title %}Side{% endblock %}

{% block body %}
    <h1>Side</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ side.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ side.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ side.description }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ side.price }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_side_index') }}">back to list</a>

    <a href="{{ path('app_side_edit', {'id': side.id}) }}">edit</a>

    {{ include('side/_delete_form.html.twig') }}
{% endblock %}
