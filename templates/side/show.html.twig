{% extends 'base.html.twig' %}

{% block title %}Accompagnements
{% endblock %}

{% block body %}
	<section class="flux mt-4">
		<h1>Accompagnements</h1>

		<table class="table">
			<tbody>
				<tr>
					<th>Id</th>
					<td>{{ side.id }}</td>
				</tr>
				<tr>
					<th>Nom</th>
					<td>{{ side.name }}</td>
				</tr>
				<tr>
					<th>Description</th>
					<td>{{ side.description }}</td>
				</tr>
				<tr>
					<th>Prix</th>
					<td>{{ side.price }}</td>
				</tr>
			</tbody>
		</table>
		<div class="mb-3">
			<a class="btn btn-info" href="{{ path('app_side_index') }}">Revenir à la liste</a>

			<a class="btn btn-warning" href="{{ path('app_side_edit', {'id': side.id}) }}">Modifier</a>
		</div>

		{{ include('side/_delete_form.html.twig') }}
	</section>
{% endblock %}
