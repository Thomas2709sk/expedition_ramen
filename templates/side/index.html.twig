{% extends 'base.html.twig' %}

{% block title %}Side index{% endblock %}

{% block body %}
    <h1>Side index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for side in sides %}
            <tr>
                <td>{{ side.id }}</td>
                <td>{{ side.name }}</td>
                <td>{{ side.description }}</td>
                <td>{{ side.price }}</td>
                <td>
                    <a href="{{ path('app_side_show', {'id': side.id}) }}">show</a>
                    <a href="{{ path('app_side_edit', {'id': side.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_side_new') }}">Create new</a>
{% endblock %}
