<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}Expedition ramen{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="...">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    {% block stylesheets %}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Open+Sans&display=swap" rel="stylesheet">
      <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap" rel="stylesheet">
      <link rel="stylesheet" href="{{ asset('styles/css/app.css') }}">
    {% endblock %}

    {% block javascripts %}
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous" defer></script>
      {% block importmap %}
        {{ importmap('app') }}
      {% endblock %}
    {% endblock %}
  </head>
  <body class="d-flex flex-column min-vh-100">
    <div class="container-fluid flex-grow-1">
      <div class="row h-100">
        <header class="col-12 p-0 col-sm-4 col-md-12 col-lg-4">
          <nav class="sidebar">
            <h2 class="fs-1">Expedition Ramen</h2>
            <a class="fs-4" href="{{ path('index') }}">Accueil</a>
            <a class="fs-4" href="#">Carte</a>
            <a class="fs-4" href="#">Réservation</a>
            <a class="fs-4" href="#">Contact</a>
          </nav>
        </header>
        <main class="col">
          {% block body %}{% endblock %}
        </main>
      </div>
    </div>
    <footer class=" d-flex justify-content-end align-items-center container-fluid">
      <p class="mb-0">&copy; 2025 Expedition Ramen.</p>
      <a href="#">Mentions légales</a>
    </footer>
  </body>
</html>