{% extends 'base.html.twig' %}

{% block title %}Ramen
{% endblock %}

{% block body %}
	<h1>Ramen</h1>

	<table class="table">
		<tbody>
			<tr>
				<th>Id</th>
				<td>{{ raman.id }}</td>
			</tr>
			<tr>
				<th>Nom</th>
				<td>{{ raman.name }}</td>
			</tr>
			<tr>
				<th>Description</th>
				<td>{{ raman.description }}</td>
			</tr>
			<tr>
				<th>Prix</th>
				<td>{{ raman.price }}</td>
			</tr>
		</tbody>
	</table>
	<div class="mb-3">
		<a class="btn btn-info" href="{{ path('app_ramen_index') }}">Revenir à la liste</a>

		<a class="btn btn-warning" href="{{ path('app_ramen_edit', {'id': raman.id}) }}">Modifier</a>
	</div>

	{{ include('ramen/_delete_form.html.twig') }}
{% endblock %}
