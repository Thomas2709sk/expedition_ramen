{% extends 'base.html.twig' %}

{% block title %}Reservations{% endblock %}

{% block body %}
    <h1>Reservations</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ reservation.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ reservation.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ reservation.email }}</td>
            </tr>
            <tr>
                <th>Téléphone</th>
                <td>{{ reservation.phone }}</td>
            </tr>
            <tr>
                <th>Commentaire</th>
                <td>{{ reservation.commentary }}</td>
            </tr>
            <tr>
                <th>Personnes</th>
                <td>{{ reservation.people }}</td>
            </tr>
            <tr>
                <th>Jour</th>
                <td>{{ reservation.day|date('d/m/Y') }}</td>
            </tr>
            <tr>
                <th>Heure</th>
                <td>{{ reservation.time ? reservation.time|date('H:i') : '' }}</td>
            </tr>
        </tbody>
    </table>
    <div class="mb-2">
    <a class="btn btn-info" href="{{ path('app_reservations_index') }}">Revenir à la liste</a>

    <a class="btn btn-warning" href="{{ path('app_reservations_edit', {'id': reservation.id}) }}">Modifier</a>
    </div>

    {{ include('reservations/_delete_form.html.twig') }}
{% endblock %}
