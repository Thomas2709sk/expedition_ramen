{% extends 'base.html.twig' %}

{% block title %}Liste des réservations{% endblock %}

{% block body %}
<section class="container mt-4">
    <h1>Liste des réservations</h1>
    <div class="table-responsive">
    <table class="table table-striped table-primary">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Téléphone</th>
                <th>Commentaire</th>
                <th>Personnes</th>
                <th>Jour</th>
                <th>Heure</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.id }}</td>
                <td>{{ reservation.name }}</td>
                <td>{{ reservation.email }}</td>
                <td>{{ reservation.phone }}</td>
                <td>{{ reservation.commentary }}</td>
                <td>{{ reservation.people }}</td>
                <td>{{ reservation.day|date('d/m/Y') }}</td>
                <td>{{ reservation.time ? reservation.time|date('H:i') : '' }}</td>
                <td>
                    <a class="btn btn-info btn-sm" href="{{ path('app_reservations_show', {'id': reservation.id}) }}">Voir</a>
                    <a class="btn btn-warning btn-sm" href="{{ path('app_reservations_edit', {'id': reservation.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">Pas de réservations</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</section>
{% endblock %}
